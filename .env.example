# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dmpilot?schema=public

# Security Configuration
JWT_SECRET=supersecret_change_me_in_production_12345678

# NextAuth Configuration
NEXTAUTH_URL=https://dmpilot.org
NEXTAUTH_SECRET=supersecret_change_me_in_production_12345678
NEXT_PUBLIC_API_URL=https://api.dmpilot.org

REDIS_URL=redis://localhost:6379


META_APP_ID=your_facebook_app_id
META_APP_SECRET=your_facebook_app_secret
META_REDIRECT_URI=https://api.dmpilot.org/instagram/callback

# SMTP / Email Configuration (Resend & Custom Domain)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
RESEND_API_KEY=re_your_resend_api_key

# Custom Domain & Support Forwarding
MAIL_DOMAIN=yourdomain.com
SUPPORT_EMAIL=yourpersonalemail@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# Optional Sender Overrides (Defaults dynamically to your MAIL_DOMAIN if omitted)
# SMTP_FROM_NOREPLY=DMPilot <no-reply@yourdomain.com>
# SMTP_FROM_BILLING=DMPilot Receipts <receipts@yourdomain.com>
# SMTP_FROM_ALERTS=DMPilot Notifications <notifications@yourdomain.com>
# Also accepted: SMTP_FROM_NO_REPLY, SMTP_FROM_RECEIPTS, SMTP_FROM_NOTIFICATIONS (SMTP_FROM is optional)
# ─── Billing / Payments ───
# Which provider /billing/checkout uses: razorpay (default) or feefree (UPI).
BILLING_PROVIDER=razorpay

# Razorpay (cards/netbanking/UPI aggregator). Required when BILLING_PROVIDER=razorpay.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# NEVER set this in production: it lets any logged-in user self-grant a paid plan.
# The API refuses it when NODE_ENV=production regardless.
# ALLOW_MOCK_CHECKOUT=false

# FeeFree (self-hosted UPI payment detection). Required when BILLING_PROVIDER=feefree.
# FEEFREE_API_URL is the FeeFree payment-api base URL.
# FEEFREE_API_URL=http://localhost:6100
# FEEFREE_API_KEY=ff_live_...
# FEEFREE_WEBHOOK_SECRET=whsec_...
# In the FeeFree merchant admin, set the merchant webhook URL to:
#   https://api.dmpilot.org/billing/webhook/feefree
# and copy the merchant webhook secret into FEEFREE_WEBHOOK_SECRET.

# CORS: comma-separated browser origins allowed to call the API with credentials.
# Defaults to FRONTEND_URL only.
# CORS_ORIGINS=https://dmpilot.org,https://www.dmpilot.org

# Enable only after FeeFree mailbox policy and signed consumer handoff are verified.
FEEFREE_SERVICE_ACCESS_ENABLED=false
