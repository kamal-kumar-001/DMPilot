# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autodm?schema=public

# Security Configuration
JWT_SECRET=supersecret_change_me_in_production_12345678

# NextAuth Configuration
NEXTAUTH_URL=https://dmpilot.org
NEXTAUTH_SECRET=supersecret_change_me_in_production_12345678
NEXT_PUBLIC_API_URL=https://api.dmpilot.org

REDIS_URL=redis://localhost:6379


META_APP_ID=your_facebook_app_id
META_APP_SECRET=your_facebook_app_secret
META_REDIRECT_URI=https://api.dmpilot.org/instagram/callback

# SMTP / Email Configuration (Resend & Custom Domain)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
RESEND_API_KEY=re_your_resend_api_key

# Custom Domain & Support Forwarding
MAIL_DOMAIN=yourdomain.com
SUPPORT_EMAIL=yourpersonalemail@gmail.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# Optional Sender Overrides (Defaults dynamically to your MAIL_DOMAIN if omitted)
# SMTP_FROM_NOREPLY=DMPilot <no-reply@yourdomain.com>
# SMTP_FROM_BILLING=DMPilot Receipts <receipts@yourdomain.com>
# SMTP_FROM_ALERTS=DMPilot Notifications <notifications@yourdomain.com>