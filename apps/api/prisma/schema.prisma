datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// --- ENUMS ---

enum UserRole {
  ADMIN
  CREATOR
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CampaignType {
  COMMENT_TO_DM
  KEYWORD_TO_DM
  WELCOME_DM
  STORY_REPLY_TO_DM
  COMMENT_REPLY
  SHARE_TO_DM
}

enum MatchingRule {
  EXACT
  CONTAINS
  STARTS_WITH
}

enum WebhookStatus {
  PENDING
  PROCESSED
  FAILED
  PAUSED
}

enum MessageDirection {
  INCOMING
  OUTGOING
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

// --- MODELS ---

model User {
  id                 String             @id @default(uuid())
  email              String             @unique
  name               String?
  password           String
  role               UserRole           @default(CREATOR)
  isVerified         Boolean            @default(false)
  verificationToken  String?
  resetToken         String?
  resetTokenExpires  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  settings           Settings?
  instagramAccounts  InstagramAccount[]
  campaigns          Campaign[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  apiLogs            ApiLog[]
  refreshTokens      RefreshToken[]
  subscription       Subscription?
  usageRecords       UsageRecord[]
  deleteRequest      DeleteRequest?
  invoices           Invoice[]
  paymentSessions    PaymentSession[]
  supportTickets     SupportTicket[]
  couponRedemptions  CouponRedemption[]
  apiKeys            ApiKey[]
  postsPublished     PostPublish[]
  adCampaigns        AdCampaign[]
}

model Settings {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             String   @default("dark")
  timezone          String   @default("UTC")
  emailNotify       Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model InstagramAccount {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramId     String     @unique
  username        String
  displayName     String?
  profilePicture  String?
  accessToken     String     // Will be encrypted transparently
  instagramPageId String?
  followersCount  Int        @default(0)
  followingCount  Int        @default(0)
  mediaCount      Int        @default(0)
  isConnected     Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?  // Soft delete support
  campaigns       Campaign[]
  comments        Comment[]
  messages        Message[]
  followerHistory FollowerHistory[]
  postsPublished  PostPublish[]
  adCampaigns     AdCampaign[]

  @@index([userId])
  @@index([deletedAt])
}

model Campaign {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  status             CampaignStatus   @default(ACTIVE)
  type               CampaignType
  replyMessage       String
  replyMediaUrl      String?
  commentReplyEnabled Boolean        @default(false)
  commentReplyText    String?
  followCheckEnabled  Boolean        @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?        // Soft delete support
  posts              Post[]
  keywords           Keyword[]
  comments           Comment[]
  messages           Message[]

  @@index([userId])
  @@index([instagramAccountId])
  @@index([deletedAt])
}

model Post {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  mediaId    String
  mediaUrl   String?
  permalink  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([campaignId])
}

model Keyword {
  id           String       @id @default(uuid())
  campaignId   String
  campaign     Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  keyword      String
  matchingRule MatchingRule @default(EXACT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([campaignId])
  @@index([keyword])
}

model WebhookEvent {
  id           String        @id @default(uuid())
  provider     String        @default("META")
  eventId      String?       @unique
  payload      Json
  status       WebhookStatus @default(PENDING)
  errorMessage String?
  commentId    String?
  username     String?
  senderId     String?
  fbtraceId    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([commentId])
  @@index([fbtraceId])
}

model Comment {
  id                 String           @id @default(uuid())
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  mediaId            String
  commentId          String           @unique
  text               String
  username           String
  userId             String           // Native Instagram User ID of commenters
  isReplied          Boolean          @default(false)
  replyText          String?
  campaignId         String?
  campaign           Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([instagramAccountId])
  @@index([mediaId])
  @@index([isReplied])
  @@index([campaignId])
  @@index([createdAt])
}

model Message {
  id                 String           @id @default(uuid())
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  recipientId        String
  senderId           String
  text               String?
  mediaUrl           String?
  messageId          String           @unique
  direction          MessageDirection
  status             MessageStatus    @default(SENT)
  errorMessage       String?
  fbtraceId          String?
  campaignId         String?
  campaign           Campaign?        @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([instagramAccountId])
  @@index([recipientId])
  @@index([status])
  @@index([campaignId])
  @@index([createdAt])
  @@index([fbtraceId])
}

model QueueJob {
  id          String    @id @default(uuid())
  name        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  runAt       DateTime
  processedAt DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([runAt])
}

model ApiLog {
  id              String   @id @default(uuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  method          String
  url             String
  statusCode      Int
  requestHeaders  Json?
  requestBody     Json?
  responseHeaders Json?
  responseBody    Json?
  duration        Int      // in milliseconds
  ipAddress       String?
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([statusCode])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ─── BILLING ARCHITECTURE (Phase 11) ───────────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(TRIAL)
  cycle              BillingCycle       @default(MONTHLY)
  trialEnds          DateTime?
  expiresAt          DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  billingAddress     Json?
  externalId         String?            // e.g. razorpay subscription / payment link id
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([userId])
  @@index([plan])
}

model Invoice {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Float
  currency       String       @default("INR")
  plan           Plan
  cycle          BillingCycle @default(MONTHLY)
  status         String       @default("PAID")
  paymentId      String?
  paymentLinkId  String?
  couponCode     String?
  discountPaise  Int          @default(0)
  pdfUrl         String?
  billingDetails Json?
  createdAt      DateTime     @default(now())

  @@index([userId])
}

// Server-side record of every FeeFree checkout session DMPilot creates.
// The webhook handler only upgrades a plan when the signed webhook matches
// this record exactly (session id, order id, amount, currency) - a browser
// callback or an unauthenticated signal never grants a paid plan.
model PaymentSession {
  id              String       @id @default(uuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        String       @default("feefree")
  orderId         String       @unique // carries the DMPilot invoice id: dmp<invoiceId without dashes> (35 chars, UPI tr limit)
  sessionId       String       @unique
  invoiceId       String?      @unique
  plan            Plan
  cycle           BillingCycle @default(MONTHLY)
  baseAmountPaise Int // payable amount before FeeFree's micro-discount
  amountPaise     Int // exact amount the customer is asked to pay
  currency        String       @default("INR")
  couponCode      String?
  discountPaise   Int          @default(0)
  billingDetails  Json?
  status          String       @default("PENDING") // PENDING | PAID | EXPIRED
  utr             String?      @unique // bank UTR - one real transaction can never fulfill two orders
  checkoutUrl     String?
  expiresAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
}

model BillingPlan {
  id             String    @id @default(uuid())
  key            Plan      @unique
  name           String
  description    String?
  priceMonthly   Float     @default(0.0)
  priceYearly    Float     @default(0.0)
  campaignLimit  Int       @default(1)
  keywordLimit   Int       @default(3)
  dmLimitMonthly Int       @default(100)
  accountLimit   Int       @default(-1) // max connected Instagram accounts; -1 = unlimited
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  // Plans that have this feature enabled (comma-separated or use array once PG supports it)
  enabledForPlans String @default("FREE,PRO,ENTERPRISE")
  // Global kill-switch override (false = off for everyone)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UsageRecord {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric    String   // e.g. "dms_sent", "campaigns_created", "accounts_connected"
  value     Int      @default(0)
  period    String   // e.g. "2024-07" (YYYY-MM)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, metric, period])
  @@index([userId])
  @@index([period])
}

model DeleteRequest {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  feedback  String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  message   String
  status    String   @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model FollowerHistory {
  id                 String           @id @default(uuid())
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  followerCount      Int
  date               DateTime         @default(now())

  @@unique([instagramAccountId, date])
  @@index([instagramAccountId])
}

model Coupon {
  id                    String             @id @default(uuid())
  code                  String             @unique
  description           String?
  discountType          CouponDiscountType @default(PERCENTAGE)
  discountValue         Int                // PERCENTAGE: 1-100; FIXED_AMOUNT: paise
  maxDiscountPaise      Int?               // Optional cap on percentage discounts in paise
  minOrderAmountPaise   Int?               // Minimum order amount in paise
  maxRedemptions        Int?               // Total allowed redemptions (null = unlimited)
  maxRedemptionsPerUser Int                @default(1)
  redemptionCount       Int                @default(0)
  applicablePlans       String             @default("PRO,ENTERPRISE") // Comma-separated Plan keys
  applicableCycles      String             @default("MONTHLY,YEARLY") // Comma-separated BillingCycle keys
  isActive              Boolean            @default(true)
  startsAt              DateTime           @default(now())
  expiresAt             DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  redemptions           CouponRedemption[]

  @@index([code])
  @@index([isActive])
}

model CouponRedemption {
  id               String   @id @default(uuid())
  couponId         String
  coupon           Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId        String?
  invoiceId        String?
  discountPaise    Int
  orderAmountPaise Int
  createdAt        DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@index([sessionId])
}

model ApiKey {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  keyHash     String    @unique
  prefix      String
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([userId])
  @@index([keyHash])
}

// --- CONTENT PUBLISHING & ADS (PHASE 5) ---

enum PublishMediaType {
  IMAGE
  REEL
  VIDEO
  CAROUSEL
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model PostPublish {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  caption            String?
  mediaUrl           String
  mediaType          PublishMediaType @default(IMAGE)
  status             PublishStatus    @default(DRAFT)
  containerId        String?
  publishedMediaId   String?
  permalink          String?
  scheduledAt        DateTime?
  publishedAt        DateTime?
  errorMessage       String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId])
  @@index([instagramAccountId])
  @@index([status])
}

enum AdObjective {
  OUTCOME_ENGAGEMENT
  OUTCOME_MESSAGES
  OUTCOME_TRAFFIC
}

enum AdCampaignStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model AdCampaign {
  id                 String           @id @default(uuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  instagramAccountId String
  instagramAccount   InstagramAccount @relation(fields: [instagramAccountId], references: [id], onDelete: Cascade)
  name               String
  objective          AdObjective      @default(OUTCOME_ENGAGEMENT)
  status             AdCampaignStatus @default(ACTIVE)
  dailyBudgetPaise   Int              @default(50000) // ₹500/day
  mediaId            String?          // Instagram media ID boosted
  metaCampaignId     String?
  metaAdSetId        String?
  metaAdId           String?
  spendPaise         Int              @default(0)
  impressions        Int              @default(0)
  clicks             Int              @default(0)
  messagesStarted    Int              @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([userId])
  @@index([instagramAccountId])
  @@index([status])
}

